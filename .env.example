# ── Slack ──────────────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-...) — OAuth & Permissions 페이지
SLACK_BOT_TOKEN=xoxb-

# socket | http  (기본 socket. Railway 에서는 socket 권장)
SLACK_MODE=socket

# socket 모드에서만 필요 — App-Level Token (xapp-...), scope: connections:write
SLACK_APP_TOKEN=xapp-

# http 모드에서만 필요 — Basic Information 페이지의 Signing Secret
SLACK_SIGNING_SECRET=
PORT=3000

# ── 저장소 ─────────────────────────────────────────────────────────
# Railway 에서는 볼륨 마운트 경로로 지정할 것 (예: /data/worklife.sqlite)
DATABASE_PATH=./data/worklife.sqlite

# ── 공개 보드 채널 ─────────────────────────────────────────────────
# 개개인의 done-next 요약이 올라갈 채널 id (예: C0123ABCDEF).
# 채널을 우클릭 → "링크 복사" 하면 URL 끝에 붙어 있다. 봇을 먼저 초대해 둘 것.
# 비워 두면 봇이 들어가 있는 채널 중 하나를 자동으로 고른다 — 채널이 둘 이상이면 지정하세요.
BOARD_CHANNEL_ID=

# ── 기본값 ─────────────────────────────────────────────────────────
DEFAULT_TZ=Asia/Seoul
# 1=월 … 7=일
DEFAULT_WORK_DAYS=1,2,3,4,5
# 아침 리마인드 — 어제 남긴 기록 되짚기
DEFAULT_CHECKIN_TIME=09:00
DEFAULT_STANDUP_TIME=17:50
DEFAULT_NUDGE_TIME=18:40
# 금요일 주간보고 발송 시각
DEFAULT_WEEKLY_TIME=17:00

# ── 근무시간(/출근 · /퇴근) ────────────────────────────────────────
# 기본 정책: 월~금 09:30~18:00, 점심 12:30~14:00 → 실 근무 7시간
#
# 점심은 "길이" 가 아니라 "구간" 이다. 근무 구간과 겹치는 만큼만 뺀다 —
# 오전 반차인 날에 1시간 30분을 빼면 안 되니까.
LUNCH_START=12:30
LUNCH_END=14:00

# 정규 퇴근 시각. 퇴근을 안 찍은 날은 이 시각으로 마감한다.
# 출근 기록 자체가 없는 날은 0 시간이다.
DEFAULT_CLOCK_OUT=18:00

# 정규 퇴근 시각을 이미 지나서 출근을 찍은 날의 대비책(시)
DEFAULT_WORK_HOURS=7

# 로그 레벨: debug | info | warn | error
LOG_LEVEL=info
